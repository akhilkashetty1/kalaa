# Kalaa environment variables.
# Local: copy to .env.local. Vercel: set the same names under Project → Settings → Environment Variables,
# with different values for Production and Preview where noted. Never commit real values.

# --- Platform -----------------------------------------------------------------------------------
# Host that serves the platform itself (marketing + studio). Creator sites live at <slug>.<ROOT_DOMAIN>.
# Production: kalaa.so (plus a wildcard *.kalaa.so domain on the Vercel project).
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# --- Database (required) ------------------------------------------------------------------------
# Local: `npm run db:local` starts a replica set on 27018 (transactions need one). Vercel: added for you by the MongoDB Atlas integration (Vercel Marketplace).
MONGODB_URI=mongodb://127.0.0.1:27018/?directConnection=true
# One database per environment. Sample data can only be seeded into names ending in _dev, _test or _preview.
#   Local: kalaa_dev   Vercel Preview: kalaa_preview   Vercel Production: kalaa
MONGODB_DB=kalaa_dev
# Connections per server instance. Keep it small on serverless.
# MONGODB_MAX_POOL_SIZE=10

# --- File storage for lesson attachments ---------------------------------------------------------
# Without a Blob token, files are kept under .data/files (development only).
# On Vercel: connect a *private* Blob store to the project; it adds BLOB_READ_WRITE_TOKEN for you.
BLOB_READ_WRITE_TOKEN=
# Force a driver: "local" or "vercel-blob". Normally left unset.
# STORAGE_DRIVER=

# --- Email (sign-in codes, invitations, announcements) -------------------------------------------
# Without these, mail is printed to the dev server log. Production refuses to send without them.
RESEND_API_KEY=
MAIL_FROM="Kalaa <signin@kalaa.so>"

# --- Custom domains ---------------------------------------------------------------------------------
# Creators point their domain here with a CNAME record. On Vercel: cname.vercel-dns.com
CNAME_TARGET=edge.kalaa.so

# Vercel for Platforms: verified creator domains are added to this project and Vercel issues SSL.
# Token: Vercel → Account Settings → Tokens (scoped to the team). Project ID: Project → Settings → General.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Alternative: Cloudflare for SaaS (when Cloudflare sits in front of the app instead).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- Scheduled publishing ----------------------------------------------------------------------------
# Vercel Cron calls /api/cron/publish every 5 minutes and sends this value as a bearer token. Any long random
# string: `openssl rand -hex 32`. Required in production. (Vercel's Hobby plan runs crons once a day at most.)
CRON_SECRET=

# --- AI first draft (optional) ---------------------------------------------------------------------------
# "Write my page with AI" in the editor appears only when this is set. Get a key at console.anthropic.com.
# Each site is limited to 6 drafts an hour. ANTHROPIC_MODEL defaults to claude-opus-5-5.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
